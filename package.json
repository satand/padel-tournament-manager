{
  "name": "padel-tournament-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "docker:start": "docker compose --env-file .env -f docker/docker-compose.yml up -d",
    "docker:stop": "docker compose --env-file .env -f docker/docker-compose.yml down",
    "docker:rebuild": "docker compose --env-file .env -f docker/docker-compose.yml up -d --build app",
    "docker:logs": "docker compose --env-file .env -f docker/docker-compose.yml logs -f app"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "date-fns": "^4.1.0",
    "next": "^16.0.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "prisma": "^6.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
