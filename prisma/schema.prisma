generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ORGANIZER
  REFEREE
  PLAYER
  PUBLIC_VIEWER
}

enum TournamentFormat {
  ROUND_ROBIN
  GROUPS_PLUS_FINALS
}

enum ScoringMode {
  SETS
  GAMES_TARGET
  TIME
}

enum FinalStartRound {
  R16
  R8
  QF
  SF
  FINAL
}

enum MvpPhase {
  GROUP
  R16
  R8
  QF
  SF
  FINAL
}

enum Bracket {
  GOLD
  SILVER
}

enum MatchSource {
  WINNER
  LOSER
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
  WALKOVER
  RETIRED
}

enum TournamentStatus {
  DRAFT
  READY
  RUNNING
  COMPLETED
  ARCHIVED
}

enum ScheduleSlotStatus {
  FREE
  RESERVED
  USED
  BLOCKED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  role         UserRole @default(ORGANIZER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournaments Tournament[] @relation("TournamentOrganizer")
  auditLogs   AuditLog[]
  mvpVotes    MVPVote[]
}

model Tournament {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String?
  format        TournamentFormat
  status        TournamentStatus @default(DRAFT)
  organizerId   String
  organizer     User             @relation("TournamentOrganizer", fields: [organizerId], references: [id])
  publicEnabled Boolean          @default(true)
  publicToken   String           @unique @default(cuid())
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  settings        TournamentSettings?
  players         Player[]
  teams           Team[]
  participants    TournamentParticipant[]
  groups          TournamentGroup[]
  matches         Match[]
  courts          Court[]
  scheduleSlots   ScheduleSlot[]
  rankingRules    RankingRule[]
  tieBreakerRules TieBreakerRule[]
  rankings        Ranking[]
  mvpStandings    MVPStanding[]
  auditLogs       AuditLog[]

  @@index([organizerId])
}

model TournamentSettings {
  id                     String          @id @default(cuid())
  tournamentId           String          @unique
  tournament             Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  maxPlayers             Int?
  courtsCount            Int             @default(2)
  matchDurationMinutes   Int             @default(30)
  maxMatchesPerPlayerDay Int             @default(6)
  minRestMinutes         Int             @default(15)
  setsPerMatch           Int             @default(1)
  gamesPerSet            Int             @default(6)
  allowDraws             Boolean         @default(false)
  tieBreakEnabled        Boolean         @default(true)
  superTieBreakEnabled   Boolean         @default(false)
  goldenPointEnabled     Boolean         @default(true)
  killerPointEnabled     Boolean         @default(false)
  mvpEnabled             Boolean         @default(true)
  scoringMode            ScoringMode     @default(SETS)
  maxSets                Int             @default(1)
  targetGames            Int?
  finalScoringMode       ScoringMode?
  finalSetsPerMatch      Int?
  finalGamesPerSet       Int?
  finalTargetGames       Int?
  groupCount             Int?
  qualifiedPerGroup      Int             @default(2)
  finalStartRound        FinalStartRound @default(FINAL)
  splitGoldSilver        Boolean         @default(false)
  mvpThroughPhase        MvpPhase        @default(FINAL)
  presentSlideSeconds    Int?
  mvpWeights             Json
  scoreRules             Json
  customRules            Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model Player {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  nickname     String?
  phone        String?
  email        String?
  category     String?
  level        String?
  initialRank  Int?
  seed         Int?
  notes        String?
  isWithdrawn  Boolean    @default(false)
  isSubstitute Boolean    @default(false)
  isJoker      Boolean    @default(false)
  feeDueCents  Int?
  feePaidCents Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  teamMemberships TeamPlayer[]
  mvpVotes        MVPVote[]
  mvpStanding     MVPStanding?

  @@index([tournamentId])
}

model Team {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  seed         Int?
  initialRank  Int?
  isWithdrawn  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  members     TeamPlayer[]
  participant TournamentParticipant?

  @@index([tournamentId])
}

model TeamPlayer {
  id       String @id @default(cuid())
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
}

model TournamentParticipant {
  id           String           @id @default(cuid())
  tournamentId String
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  displayName  String
  level        Float?
  teamId       String           @unique
  team         Team             @relation(fields: [teamId], references: [id])
  groupId      String?
  group        TournamentGroup? @relation(fields: [groupId], references: [id])
  seed         Int?
  initialRank  Int?
  isWithdrawn  Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  rankings     Ranking[]
  matchesAsA   Match[]   @relation("MatchParticipantA")
  matchesAsB   Match[]   @relation("MatchParticipantB")
  matchWinners Match[]   @relation("MatchWinner")

  @@index([tournamentId])
  @@index([groupId])
}

model TournamentGroup {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  participants TournamentParticipant[]
  matches      Match[]

  @@index([tournamentId])
  @@map("Group")
}

model Court {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  order        Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  matches       Match[]
  scheduleSlots ScheduleSlot[]

  @@index([tournamentId])
}

model ScheduleSlot {
  id           String             @id @default(cuid())
  tournamentId String
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  courtId      String
  court        Court              @relation(fields: [courtId], references: [id])
  startsAt     DateTime
  endsAt       DateTime
  status       ScheduleSlotStatus @default(FREE)
  matchId      String?            @unique
  match        Match?

  @@index([tournamentId, startsAt])
  @@index([courtId, startsAt])
}

model Match {
  id             String                 @id @default(cuid())
  tournamentId   String
  tournament     Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupId        String?
  group          TournamentGroup?       @relation(fields: [groupId], references: [id])
  participantAId String?
  participantA   TournamentParticipant? @relation("MatchParticipantA", fields: [participantAId], references: [id])
  participantBId String?
  participantB   TournamentParticipant? @relation("MatchParticipantB", fields: [participantBId], references: [id])
  winnerId       String?
  winner         TournamentParticipant? @relation("MatchWinner", fields: [winnerId], references: [id])
  courtId        String?
  court          Court?                 @relation(fields: [courtId], references: [id])
  scheduleSlotId String?                @unique
  scheduleSlot   ScheduleSlot?          @relation(fields: [scheduleSlotId], references: [id])
  scheduledAt    DateTime?
  roundIndex     Int                    @default(1)
  phase          String                 @default("group")
  bracket        Bracket?
  parentMatchIdA String?
  parentResultA  MatchSource?
  parentMatchIdB String?
  parentResultB  MatchSource?
  status         MatchStatus            @default(SCHEDULED)
  note           String?
  phaseWeight    Float                  @default(1)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  sets     MatchSet[]
  result   MatchResult?
  mvpVotes MVPVote[]

  @@index([tournamentId])
  @@index([scheduledAt])
  @@index([courtId, scheduledAt])
}

model MatchSet {
  id              String  @id @default(cuid())
  matchId         String
  match           Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  setNumber       Int
  gamesA          Int
  gamesB          Int
  tieBreakA       Int?
  tieBreakB       Int?
  isSuperTieBreak Boolean @default(false)

  @@unique([matchId, setNumber])
}

model MatchResult {
  id             String      @id @default(cuid())
  matchId        String      @unique
  match          Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  status         MatchStatus
  completedAt    DateTime?
  enteredById    String?
  rawScore       Json
  validationHash String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Ranking {
  id            String                @id @default(cuid())
  tournamentId  String
  tournament    Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participantId String
  participant   TournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  scope         String                @default("overall")
  position      Int
  played        Int                   @default(0)
  won           Int                   @default(0)
  lost          Int                   @default(0)
  drawn         Int                   @default(0)
  points        Float                 @default(0)
  setsWon       Int                   @default(0)
  setsLost      Int                   @default(0)
  setDiff       Int                   @default(0)
  gamesWon      Int                   @default(0)
  gamesLost     Int                   @default(0)
  gameDiff      Int                   @default(0)
  winPercentage Float                 @default(0)
  avgGamesWon   Float                 @default(0)
  avgMvpRating  Float?
  computedAt    DateTime              @default(now())

  @@unique([tournamentId, participantId, scope])
}

model RankingRule {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  key          String
  label        String
  value        Json
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)

  @@index([tournamentId])
}

model TieBreakerRule {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  key          String
  label        String
  sortOrder    Int
  isActive     Boolean    @default(true)

  @@index([tournamentId])
}

model MVPVote {
  id           String   @id @default(cuid())
  tournamentId String
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  voterId      String?
  voter        User?    @relation(fields: [voterId], references: [id])
  source       String   @default("organizer")
  rating       Float
  penalty      Float    @default(0)
  weight       Float    @default(1)
  notes        String?
  createdAt    DateTime @default(now())

  @@index([tournamentId])
  @@index([matchId])
  @@index([playerId])
}

model MVPStanding {
  id             String     @id @default(cuid())
  tournamentId   String
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerId       String     @unique
  player         Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  position       Int
  mvpCount       Int        @default(0)
  avgRating      Float      @default(0)
  weightedRating Float      @default(0)
  finalBonus     Float      @default(0)
  penalties      Float      @default(0)
  totalScore     Float      @default(0)
  eligible       Boolean    @default(true)
  computedAt     DateTime   @default(now())

  @@unique([tournamentId, playerId])
}

model AuditLog {
  id            String      @id @default(cuid())
  tournamentId  String?
  tournament    Tournament? @relation(fields: [tournamentId], references: [id])
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  entityType    String
  entityId      String
  action        String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  @@index([tournamentId])
  @@index([entityType, entityId])
}
